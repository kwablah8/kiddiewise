{
  "name": "school-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "gen:types": "supabase gen types typescript --local > lib/supabase/types.ts",
    "seed:demo": "NODE_OPTIONS=--experimental-websocket tsx scripts/seed-demo.ts",
    "db:seed": "pnpm db:reset && pnpm seed:demo",
    "test:rls": "NODE_OPTIONS=--experimental-websocket vitest run tests/rls",
    "test:unit": "vitest run tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-websocket vitest run tests/integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
