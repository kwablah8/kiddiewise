NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase start`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase start`>  # server-only, never NEXT_PUBLIC

# Base URL used to build password-setup links in invitation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — the marketing site's CMS (news, gallery photos, contact/admissions details).
# BOTH ARE OPTIONAL. Leave them unset and the public site renders the content compiled into
# `lib/marketing/site.ts` / `media.ts` exactly as it always has, and /studio shows a short
# "not configured" note. That is also how CI builds.
# No API token is needed: free-plan datasets are public, so published content reads without one.
NEXT_PUBLIC_SANITY_PROJECT_ID=<project id from sanity.io/manage>
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the publish webhook (POST /api/revalidate-sanity), which makes an edit appear on
# the site immediately instead of waiting out the 5-minute backstop. Generate with
# `openssl rand -hex 24` and paste the SAME value into manage.sanity.io -> API -> Webhooks -> Secret.
# Server-only, never NEXT_PUBLIC. If unset the endpoint refuses every request (it cannot verify the
# signature) and the site falls back to time-based revalidation.
SANITY_REVALIDATE_SECRET=<openssl rand -hex 24>
